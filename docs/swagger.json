{
    "swagger": "2.0",
    "info": {
        "description": "API RESTful para gestión de cuentas, transacciones y auditoría financiera con arquitectura hexagonal.",
        "title": "Goallet API - Motor Transaccional de Billetera Digital",
        "termsOfService": "http://swagger.io/terms/",
        "contact": {
            "name": "Julian Dario Serna Saavedra",
            "url": "https://github.com/Julianfreak/Goallet-api",
            "email": "julianrideon@gmail.com"
        },
        "license": {
            "name": "MIT",
            "url": "https://opensource.org/licenses/MIT"
        },
        "version": "1.0"
    },
    "host": "localhost:8090",
    "basePath": "/api/v1",
    "paths": {
        "/api/v1/cuentas/{id}/movimientos": {
            "get": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Retorna la lista paginada y filtrada por fecha del ledger de una cuenta",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Movimientos"
                ],
                "summary": "Consultar historial de transacciones (Ledger)",
                "parameters": [
                    {
                        "type": "string",
                        "description": "ID de la Cuenta",
                        "name": "id",
                        "in": "path",
                        "required": true
                    },
                    {
                        "type": "integer",
                        "description": "Cantidad de registros por página (default 20)",
                        "name": "limit",
                        "in": "query"
                    },
                    {
                        "type": "integer",
                        "description": "Número de página (default 1)",
                        "name": "page",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "Fecha inicial (YYYY-MM-DD o RFC3339)",
                        "name": "fecha_inicio",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "Fecha final (YYYY-MM-DD o RFC3339)",
                        "name": "fecha_fin",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    }
                }
            }
        },
        "/cuentas": {
            "get": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Obtiene el listado completo de cuentas registradas en el sistema",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Cuentas"
                ],
                "summary": "Listar todas las cuentas",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/domain.Cuenta"
                            }
                        }
                    },
                    "500": {
                        "description": "Error interno del servidor",
                        "schema": {
                            "$ref": "#/definitions/dto.ErrorResponse"
                        }
                    }
                }
            },
            "post": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Registra un titular y asigna un saldo inicial opcional",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Cuentas"
                ],
                "summary": "Crear nueva cuenta bancaria",
                "parameters": [
                    {
                        "description": "Datos de apertura de cuenta",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/dto.CrearCuentaRequest"
                        }
                    }
                ],
                "responses": {
                    "201": {
                        "description": "Created",
                        "schema": {
                            "$ref": "#/definitions/domain.Cuenta"
                        }
                    },
                    "400": {
                        "description": "Formato de datos inválido o titular ausente",
                        "schema": {
                            "$ref": "#/definitions/dto.ErrorResponse"
                        }
                    },
                    "500": {
                        "description": "Error interno del servidor",
                        "schema": {
                            "$ref": "#/definitions/dto.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/cuentas/{id}": {
            "get": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Obtiene la información detallada de una cuenta existente",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Cuentas"
                ],
                "summary": "Consultar cuenta por ID",
                "parameters": [
                    {
                        "type": "string",
                        "description": "ID de la cuenta",
                        "name": "id",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/domain.Cuenta"
                        }
                    },
                    "404": {
                        "description": "Cuenta no encontrada",
                        "schema": {
                            "$ref": "#/definitions/dto.ErrorResponse"
                        }
                    },
                    "500": {
                        "description": "Error interno del servidor",
                        "schema": {
                            "$ref": "#/definitions/dto.ErrorResponse"
                        }
                    }
                }
            },
            "put": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Modifica el nombre del titular asociado a una cuenta",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Cuentas"
                ],
                "summary": "Actualizar el titular de una cuenta",
                "parameters": [
                    {
                        "type": "string",
                        "description": "ID de la cuenta",
                        "name": "id",
                        "in": "path",
                        "required": true
                    },
                    {
                        "description": "Nuevo nombre del titular",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/dto.ActualizarTitularRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/domain.Cuenta"
                        }
                    },
                    "400": {
                        "description": "Petición inválida",
                        "schema": {
                            "$ref": "#/definitions/dto.ErrorResponse"
                        }
                    },
                    "404": {
                        "description": "Cuenta no encontrada",
                        "schema": {
                            "$ref": "#/definitions/dto.ErrorResponse"
                        }
                    }
                }
            },
            "delete": {
                "description": "Elimina una cuenta existente únicamente si su saldo es igual a 0",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Cuentas"
                ],
                "summary": "Eliminar una cuenta",
                "parameters": [
                    {
                        "type": "string",
                        "description": "ID de la cuenta",
                        "name": "id",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Cuenta eliminada exitosamente",
                        "schema": {
                            "$ref": "#/definitions/dto.MensajeResponse"
                        }
                    },
                    "400": {
                        "description": "La cuenta tiene saldo pendiente",
                        "schema": {
                            "$ref": "#/definitions/dto.ErrorResponse"
                        }
                    },
                    "404": {
                        "description": "Cuenta no encontrada",
                        "schema": {
                            "$ref": "#/definitions/dto.ErrorResponse"
                        }
                    },
                    "500": {
                        "description": "Error interno del servidor",
                        "schema": {
                            "$ref": "#/definitions/dto.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/cuentas/{id}/depositar": {
            "post": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Incrementa el saldo de una cuenta con un monto positivo",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Transacciones"
                ],
                "summary": "Realizar un depósito",
                "parameters": [
                    {
                        "type": "string",
                        "description": "ID de la cuenta",
                        "name": "id",
                        "in": "path",
                        "required": true
                    },
                    {
                        "description": "Monto a depositar",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/dto.OperacionMontoRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/domain.Transaccion"
                        }
                    },
                    "400": {
                        "description": "Monto inválido o cuerpo de petición incorrecto",
                        "schema": {
                            "$ref": "#/definitions/dto.ErrorResponse"
                        }
                    },
                    "404": {
                        "description": "Cuenta no encontrada",
                        "schema": {
                            "$ref": "#/definitions/dto.ErrorResponse"
                        }
                    },
                    "500": {
                        "description": "Error interno del servidor",
                        "schema": {
                            "$ref": "#/definitions/dto.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/cuentas/{id}/retirar": {
            "post": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Deduce un monto de una cuenta si dispone de saldo suficiente",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Transacciones"
                ],
                "summary": "Realizar un retiro",
                "parameters": [
                    {
                        "type": "string",
                        "description": "ID de la cuenta",
                        "name": "id",
                        "in": "path",
                        "required": true
                    },
                    {
                        "description": "Monto a retirar",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/dto.OperacionMontoRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/domain.Transaccion"
                        }
                    },
                    "400": {
                        "description": "Monto inválido o saldo insuficiente",
                        "schema": {
                            "$ref": "#/definitions/dto.ErrorResponse"
                        }
                    },
                    "404": {
                        "description": "Cuenta no encontrada",
                        "schema": {
                            "$ref": "#/definitions/dto.ErrorResponse"
                        }
                    },
                    "500": {
                        "description": "Error interno del servidor",
                        "schema": {
                            "$ref": "#/definitions/dto.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/cuentas/{id}/transferir": {
            "post": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Realiza una transferencia desde la cuenta origen hacia la cuenta de destino",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Transacciones"
                ],
                "summary": "Transferir fondos entre cuentas",
                "parameters": [
                    {
                        "type": "string",
                        "description": "ID de la cuenta origen",
                        "name": "id",
                        "in": "path",
                        "required": true
                    },
                    {
                        "description": "Datos de la transferencia",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/dto.TransferirRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/domain.Transaccion"
                        }
                    },
                    "400": {
                        "description": "Datos inválidos, saldo insuficiente o misma cuenta",
                        "schema": {
                            "$ref": "#/definitions/dto.ErrorResponse"
                        }
                    },
                    "404": {
                        "description": "Cuenta no encontrada",
                        "schema": {
                            "$ref": "#/definitions/dto.ErrorResponse"
                        }
                    },
                    "500": {
                        "description": "Error interno del servidor",
                        "schema": {
                            "$ref": "#/definitions/dto.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/health": {
            "get": {
                "description": "Verifica que la API esté operativa y, si hay pool de BD, que la conexión a PostgreSQL responda. Usado por el ALB de AWS ECS Fargate.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Health"
                ],
                "summary": "Comprobación de estado del servicio",
                "responses": {
                    "200": {
                        "description": "Servicio operativo",
                        "schema": {
                            "$ref": "#/definitions/handlers.HealthResponse"
                        }
                    },
                    "503": {
                        "description": "Base de datos no disponible",
                        "schema": {
                            "$ref": "#/definitions/handlers.HealthResponse"
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "domain.Cuenta": {
            "type": "object",
            "properties": {
                "created_at": {
                    "type": "string"
                },
                "id": {
                    "type": "string"
                },
                "saldo": {
                    "type": "number"
                },
                "titular": {
                    "type": "string"
                }
            }
        },
        "domain.TipoTransaccion": {
            "type": "string",
            "enum": [
                "DEPOSITO",
                "RETIRO",
                "TRANSFERENCIA"
            ],
            "x-enum-varnames": [
                "Deposito",
                "Retiro",
                "Transferencia"
            ]
        },
        "domain.Transaccion": {
            "type": "object",
            "properties": {
                "cuenta_destino_id": {
                    "type": "string"
                },
                "cuenta_origen_id": {
                    "type": "string"
                },
                "fecha": {
                    "type": "string"
                },
                "id": {
                    "type": "string"
                },
                "monto": {
                    "type": "number"
                },
                "tipo": {
                    "$ref": "#/definitions/domain.TipoTransaccion"
                }
            }
        },
        "dto.ActualizarTitularRequest": {
            "type": "object",
            "required": [
                "nuevo_titular"
            ],
            "properties": {
                "nuevo_titular": {
                    "type": "string"
                }
            }
        },
        "dto.CrearCuentaRequest": {
            "type": "object",
            "required": [
                "titular"
            ],
            "properties": {
                "saldo_inicial": {
                    "type": "number"
                },
                "titular": {
                    "type": "string"
                }
            }
        },
        "dto.ErrorResponse": {
            "type": "object",
            "properties": {
                "error": {
                    "type": "string",
                    "example": "mensaje de error explicativo"
                }
            }
        },
        "dto.MensajeResponse": {
            "type": "object",
            "properties": {
                "mensaje": {
                    "type": "string",
                    "example": "operación realizada exitosamente"
                }
            }
        },
        "dto.OperacionMontoRequest": {
            "type": "object",
            "required": [
                "monto"
            ],
            "properties": {
                "monto": {
                    "type": "number"
                }
            }
        },
        "dto.TransferirRequest": {
            "type": "object",
            "required": [
                "cuenta_destino_id",
                "monto"
            ],
            "properties": {
                "cuenta_destino_id": {
                    "type": "string"
                },
                "monto": {
                    "type": "number"
                }
            }
        },
        "handlers.HealthResponse": {
            "type": "object",
            "properties": {
                "database": {
                    "type": "string",
                    "example": "connected"
                },
                "service": {
                    "type": "string",
                    "example": "goallet-api"
                },
                "status": {
                    "type": "string",
                    "example": "UP"
                },
                "timestamp": {
                    "type": "string",
                    "example": "2026-11-13T12:00:00Z"
                }
            }
        }
    },
    "securityDefinitions": {
        "BearerAuth": {
            "description": "Escribe \"Bearer \" seguido de tu token JWT. Ejemplo: \"Bearer eyJhbGciOi...\"",
            "type": "apiKey",
            "name": "Authorization",
            "in": "header"
        }
    }
}